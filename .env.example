NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Cloudinary (free image hosting, no card required) - used for profile
# photos, post images, and the gallery. Cloud name is shown on your
# Cloudinary dashboard; the preset must have Signing Mode set to "Unsigned".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# Admin email feature (welcome email on approval + bulk announcements).
# Server-only -- never prefix these with NEXT_PUBLIC_.
# Gmail App Password for the club's email account (requires 2-Step
# Verification enabled first): myaccount.google.com -> Security -> App
# passwords.
OFFICE_MAIL=your_club_gmail_address
MAIL_APP_PASSORD=your_16_character_app_password

# Firebase service account key JSON, as a single line (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key). Used
# server-side only, to verify a caller is really an admin before sending
# email -- never exposed to the browser.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Any random string. Vercel Cron automatically sends this as a Bearer token
# when it triggers the daily email-batch job -- set the same value in your
# Vercel project's env vars so the cron route can verify the request is
# really from Vercel and not a random visitor.
CRON_SECRET=your_random_secret

# Public site URL, used to build the "View your profile" link inside the
# welcome email. Optional -- the email just omits the button if unset.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example

# Self-imposed daily cap on total emails sent (welcome + announcements
# combined). Defaults to 400 if unset. This is a safety rail, not a Gmail
# rule -- anything over the cap rolls into the next day's batch rather than
# being dropped. Raise it once the mailbox's real sending ceiling is known.
NEXT_PUBLIC_DAILY_EMAIL_LIMIT=400
