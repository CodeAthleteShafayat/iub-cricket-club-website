rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myMember().isAdmin == true;
    }

    function isApprovedMember() {
      return isSignedIn() && myMember().status == 'approved';
    }

    function recruitmentWindowExists() {
      return exists(/databases/$(database)/documents/config/recruitmentWindow);
    }

    function recruitmentWindow() {
      return get(/databases/$(database)/documents/config/recruitmentWindow).data;
    }

    function recruitmentWindowOpen() {
      return recruitmentWindowExists()
          && recruitmentWindow().startAt <= request.time
          && request.time <= recruitmentWindow().endAt;
    }

    function approvalStampMatchesWindow() {
      return recruitmentWindowExists()
          && request.resource.data.recruitmentSeason == recruitmentWindow().season
          && request.resource.data.recruitmentYear == recruitmentWindow().year;
    }

    function isBecomingApproved() {
      return resource.data.status != 'approved' && request.resource.data.status == 'approved';
    }

    match /members/{uid} {
      // Member docs hold personal data (phone, student ID, date of birth, blood
      // group), so they are readable only by the member themselves and admins.
      // Nothing public renders other people's member docs — community messages
      // carry their own denormalized authorName/authorPhotoURL.
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isAdmin == false
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() > 0
                    && request.resource.data.dateOfBirth is string
                    && request.resource.data.dateOfBirth.size() > 0
                    && request.resource.data.bloodGroup in
                       ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
                    && request.resource.data.playingExperience in
                       ['none', 'school', 'college', 'university', 'club', 'professional']
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email.lower().matches('^[a-z0-9._%+-]+@iub\\.edu\\.bd$');

      // A member editing their own profile may never change their status, admin
      // flag, recruitment cohort, identity, or the review audit trail — those are
      // admin/server-owned. Legacy docs predate the recruitment fields, so those
      // two are compared with .get(..., null) rather than direct access.
      allow update: if (isAdmin()
                         && (!isBecomingApproved()
                             || (recruitmentWindowOpen() && approvalStampMatchesWindow())))
                    || (isOwner(uid)
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.isAdmin == resource.data.isAdmin
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.reviewedBy == resource.data.reviewedBy
                        && request.resource.data.reviewedAt == resource.data.reviewedAt
                        && request.resource.data.get('recruitmentSeason', null) == resource.data.get('recruitmentSeason', null)
                        && request.resource.data.get('recruitmentYear', null) == resource.data.get('recruitmentYear', null));

      allow delete: if isAdmin();
    }

    match /config/recruitmentWindow {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.season in ['Spring', 'Summer', 'Autumn']
                            && request.resource.data.year is string
                            && request.resource.data.startAt is timestamp
                            && request.resource.data.endAt is timestamp
                            && request.resource.data.startAt < request.resource.data.endAt
                            && request.resource.data.setBy == request.auth.uid;
      allow delete: if false;
    }

    match /content/about {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /communityMessages/{messageId} {
      allow read: if isApprovedMember();
      // authorName is pinned to the sender's real member name so nobody can post
      // under someone else's name; text is capped and createdAt must be the
      // server's clock so the feed can't be forged or spammed with huge payloads.
      allow create: if isApprovedMember()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorName == myMember().name
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /galleryImages/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Photo albums. Public read like the gallery itself; only admins write.
    // delete is deliberately its own clause -- see the note above /tournaments.
    match /albums/{albumId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.photoCount is int
                    && request.resource.data.photoCount >= 0;
    }

    // Tournaments and matches are public like posts/gallery -- fixtures,
    // results, and the points table are meant to be shareable without a login.
    // NOTE: delete is a SEPARATE clause on purpose. On a delete there is no
    // incoming document, so request.resource is null and every
    // request.resource.data.* check below evaluates false -- folding delete
    // into the validating clause silently denies all deletes. That was a real
    // shipped bug here; don't merge them back.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.status in ['upcoming', 'ongoing', 'completed']
                    && request.resource.data.oversPerInnings is int
                    && request.resource.data.oversPerInnings > 0
                    && request.resource.data.oversPerInnings <= 60
                    && request.resource.data.pointsForWin is int
                    && request.resource.data.pointsForWin >= 0
                    && request.resource.data.pointsForTie is int
                    && request.resource.data.pointsForTie >= 0;
    }

    // Note: the nested inningsA/inningsB maps aren't validated here -- rules
    // can't check optional nested shapes without a lot of noise, and these are
    // admin-only writes. MatchResultForm validates them with zod; this block is
    // defence-in-depth on the fields that would corrupt the points table.
    match /matches/{matchId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                    && request.resource.data.teamA is string
                    && request.resource.data.teamA.size() > 0
                    && request.resource.data.teamA.size() <= 60
                    && request.resource.data.teamB is string
                    && request.resource.data.teamB.size() > 0
                    && request.resource.data.teamB.size() <= 60
                    && request.resource.data.teamA != request.resource.data.teamB
                    && request.resource.data.oversPerInnings is int
                    && request.resource.data.oversPerInnings > 0
                    && request.resource.data.oversPerInnings <= 60
                    && request.resource.data.status in ['scheduled', 'completed', 'abandoned'];
    }

    // Written only by the admin API routes via the Firebase Admin SDK
    // (src/lib/server/campaigns.ts, src/lib/server/mailer.ts), which
    // bypasses these rules entirely -- the client only ever reads campaign
    // status to render progress, and never touches the quota counter.
    match /emailCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /emailQuota/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One doc per applicant who has been sent the "application received"
    // email, written only by /api/send-pending-email via the Admin SDK. This
    // is what stops that route from being looped to drain the shared daily
    // email quota, so it must stay unwritable from the client -- in
    // particular it deliberately does NOT live on the member doc, which a
    // member is allowed to update themselves.
    match /pendingEmailClaims/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
