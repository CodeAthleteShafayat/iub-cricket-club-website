rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myMember().isAdmin == true;
    }

    function isApprovedMember() {
      return isSignedIn() && myMember().status == 'approved';
    }

    match /members/{uid} {
      allow read: if resource.data.status == 'approved' || isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isAdmin == false;

      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.isAdmin == resource.data.isAdmin);

      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /communityMessages/{messageId} {
      allow read: if isApprovedMember();
      allow create: if isApprovedMember()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /galleryImages/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
